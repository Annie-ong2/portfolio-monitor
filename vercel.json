{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/tradesSave",  "dest": "/api/tradesSave.js"  },
    { "src": "/api/trades",      "dest": "/api/trades.js"      },
    { "src": "/api/quote",       "dest": "/api/quote.js"       },
    { "src": "/api/news",        "dest": "/api/news.js"        },
    { "src": "/api/analyze",     "dest": "/api/analyze.js"     },
    { "src": "/api/account",     "dest": "/api/account.js"     },
    { "src": "/(.*)",            "dest": "/public/index.html"  }
  ]
}
